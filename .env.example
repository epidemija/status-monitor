# Server
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# Where this monitor is physically running. Shown on the public page so viewers
# know where the response-time numbers were measured from. Optional.
# Examples: "Frankfurt, DE", "Falkenstein, DE", "Local (development)"
MEASUREMENT_REGION=

# Initial admin (used only on first boot to seed the admin user)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!2026

# How often the scheduler runs the monitoring sweep (cron syntax).
# Default: every 5 minutes.
CHECK_CRON=*/5 * * * *

# How many consecutive failed checks before raising an incident & sending alerts
ALERT_THRESHOLD=2

# Don't re-alert about the same site for at least this many minutes
ALERT_COOLDOWN_MINUTES=60

# ---- SMTP / Email (optional, for outage alerts) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Status Monitor <noreply@example.com>"

# ---- Twilio WhatsApp (optional) ----
# Sign up at twilio.com, enable the WhatsApp sandbox or buy a number,
# then put the credentials below.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Must be in format: whatsapp:+14155238886 (Twilio sandbox)
TWILIO_WHATSAPP_FROM=
