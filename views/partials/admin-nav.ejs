<aside class="sidebar">
  <a class="sidebar-brand" href="/admin">Status Monitor</a>
  <nav class="sidebar-nav">
    <a href="/admin" class="<%= currentPath === '/' ? 'nav-active' : '' %>">Dashboard</a>
    <a href="/admin/sites" class="<%= currentPath.startsWith('/sites') ? 'nav-active' : '' %>">Sites</a>
    <a href="/admin/incidents" class="<%= currentPath.startsWith('/incidents') ? 'nav-active' : '' %>">Incidents</a>
    <a href="/admin/status-codes" class="<%= currentPath.startsWith('/status-codes') ? 'nav-active' : '' %>">Status codes</a>
    <a href="/admin/reports" class="<%= currentPath.startsWith('/reports') ? 'nav-active' : '' %>">Reports</a>
    <a href="/admin/settings" class="<%= currentPath.startsWith('/settings') ? 'nav-active' : '' %>">Settings</a>
    <% if (userRole === 'admin') { %>
      <div class="sidebar-divider"></div>
      <a href="/admin/users" class="<%= currentPath.startsWith('/users') ? 'nav-active' : '' %>">Users</a>
      <a href="/admin/pending" class="<%= currentPath.startsWith('/pending') ? 'nav-active' : '' %>">
        Pending<% if (pendingCount > 0) { %><span class="sidebar-badge"><%= pendingCount %></span><% } %>
      </a>
    <% } %>
    <div class="sidebar-divider"></div>
    <a href="/admin/account" class="<%= currentPath.startsWith('/account') ? 'nav-active' : '' %>">Account</a>
    <a href="/" target="_blank" rel="noopener">Public page ↗</a>
  </nav>
  <div class="sidebar-bottom">
    <span class="sidebar-user-email"><%= userEmail %></span>
    <span class="sidebar-user-role"><%= userRole %></span>
    <form action="/logout" method="post">
      <button class="btn-logout" type="submit">Sign out</button>
    </form>
  </div>
</aside>
<div class="admin-body">
