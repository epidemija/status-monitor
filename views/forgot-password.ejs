<%- include('partials/head', { title: 'Reset password' }) %>
<main class="auth-shell">
  <div class="auth-card">
    <h1>Reset password</h1>
    <% if (sent) { %>
      <p class="muted">If that email address is registered, you will receive a reset link shortly. Check your inbox.</p>
      <p class="muted small" style="margin-top:20px;"><a href="/login">← Back to sign in</a></p>
    <% } else { %>
      <p class="muted">Enter your account email and we'll send you a link to set a new password.</p>
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <form action="/forgot-password" method="post">
        <label style="display:block; margin:14px 0; font-weight:600;">Email address
          <input type="email" name="email" required autofocus autocomplete="email"
                 style="width:100%; padding:8px 10px; border:1px solid var(--border); border-radius:6px; font-size:1rem; margin-top:4px; background:#fff;" />
        </label>
        <button class="btn btn-primary" type="submit" style="width:100%;">Send reset link</button>
      </form>
      <p class="muted small" style="margin-top:16px;"><a href="/login">← Back to sign in</a></p>
    <% } %>
  </div>
</main>
</body>
</html>
