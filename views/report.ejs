<%- include('partials/head', { title: 'Report an issue' }) %>
<header class="status-header status-muted">
  <div class="container">
    <h1>Report an issue</h1>
    <p class="overall">Tell us what's wrong — your report goes straight to the team.</p>
  </div>
</header>
<main class="container narrow" style="padding-top: 8px;">
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <form class="form" method="post" action="/report">

    <div class="card" style="margin-top: 24px;">
      <label style="font-weight:700; font-size:1.05rem; display:block; margin-bottom: 10px;">
        What's the issue?
        <span class="muted small" style="font-weight:400; margin-left:4px;">(required · min 10 characters)</span>
      </label>
      <textarea name="description" rows="7" required minlength="10" maxlength="5000"
        style="width:100%; padding:10px 12px; border:1px solid var(--border); border-radius:8px;
               font-size:1rem; font-family:inherit; resize:vertical; background:#fff; line-height:1.55;"
        placeholder="Describe what you saw, what you expected, and any steps to reproduce the problem..."
      ><%= values.description || '' %></textarea>
    </div>

    <div class="card" style="margin-top: 16px;">
      <h2 style="margin-top:0; margin-bottom:14px; font-size:1rem;">Details <span class="muted small" style="font-weight:400;">(optional)</span></h2>

      <label>Which website?
        <select name="site_id" style="width:100%; padding:8px 10px; border:1px solid var(--border); border-radius:6px; font:inherit; margin-top:4px; background:#fff;">
          <option value="">— Not sure / general feedback —</option>
          <% sites.forEach(s => { %>
            <option value="<%= s.id %>" <%= preselectedSiteId === s.id ? 'selected' : '' %>><%= s.name %> — <%= s.url %></option>
          <% }) %>
        </select>
      </label>

      <label style="margin-top:14px; display:block;">Severity
        <select name="severity" style="width:100%; padding:8px 10px; border:1px solid var(--border); border-radius:6px; font:inherit; margin-top:4px; background:#fff;">
          <option value="low"    <%= (values.severity || 'medium') === 'low' ? 'selected' : '' %>>Low — minor cosmetic issue</option>
          <option value="medium" <%= (values.severity || 'medium') === 'medium' ? 'selected' : '' %>>Medium — broken but workable</option>
          <option value="high"   <%= values.severity === 'high' ? 'selected' : '' %>>High — site is down or unusable</option>
        </select>
      </label>

      <label style="margin-top:14px; display:block;">Page URL where you noticed the problem
        <input type="url" name="page_url" placeholder="https://…"
               value="<%= values.page_url || '' %>"
               style="width:100%; padding:8px 10px; border:1px solid var(--border); border-radius:6px; font:inherit; margin-top:4px; background:#fff;" />
      </label>
    </div>

    <div class="card" style="margin-top: 16px;">
      <h2 style="margin-top:0; margin-bottom:14px; font-size:1rem;">Your contact details <span class="muted small" style="font-weight:400;">(optional)</span></h2>
      <div class="form-row">
        <label>Name
          <input type="text" name="reporter_name" maxlength="120" value="<%= values.reporter_name || '' %>"
                 style="width:100%; padding:8px 10px; border:1px solid var(--border); border-radius:6px; font:inherit; margin-top:4px; background:#fff;" />
        </label>
        <label>Email <span class="muted small">(for follow-up)</span>
          <input type="email" name="reporter_email" maxlength="240" value="<%= values.reporter_email || '' %>"
                 style="width:100%; padding:8px 10px; border:1px solid var(--border); border-radius:6px; font:inherit; margin-top:4px; background:#fff;" />
        </label>
      </div>
    </div>

    <div style="display:flex; gap:10px; justify-content:flex-end; margin-top:20px; align-items:center;">
      <a class="btn btn-ghost" href="/">Cancel</a>
      <button class="btn btn-primary" type="submit" style="padding: 10px 24px; font-size:1rem;">Submit report</button>
    </div>
    <p class="muted small" style="text-align:right; margin-top:8px;">No personal data is stored beyond what you enter and your browser's user-agent string.</p>
  </form>
</main>
</body>
</html>
