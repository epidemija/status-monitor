<%- include('../partials/head', { title: 'Admin · Users' }) %>
<%- include('../partials/admin-nav') %>
<main class="container">
  <h1>Users</h1>
  <% if (flash) { %><div class="alert alert-info"><%= decodeURIComponent(flash) %></div><% } %>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <section class="card">
    <h2>All users</h2>
    <table class="table">
      <thead>
        <tr>
          <th>Email</th>
          <th>Role</th>
          <th>Created</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(u => { %>
          <tr>
            <td><%= u.email %></td>
            <td><span class="<%= u.role === 'admin' ? 'ok' : 'muted' %>"><%= u.role %></span></td>
            <td class="muted small"><%= new Date(u.created_at + 'Z').toLocaleString() %></td>
            <td>
              <% if (u.email !== userEmail) { %>
                <form action="/admin/users/<%= u.id %>/delete" method="post" style="display:inline"
                      onsubmit="return confirm('Remove user <%= u.email %>?')">
                  <button class="btn btn-ghost small" type="submit">Remove</button>
                </form>
              <% } else { %>
                <span class="muted small">you</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>

  <form class="card form" action="/admin/users/new" method="post">
    <h2>Add user</h2>
    <label>Email address<input type="email" name="email" required autocomplete="off" /></label>
    <label>Initial password (min 8 chars)<input type="password" name="password" required minlength="8" autocomplete="new-password" /></label>
    <label>Role
      <select name="role">
        <option value="moderator">Moderator — write actions require admin approval</option>
        <option value="admin">Admin — full access</option>
      </select>
    </label>
    <div class="form-actions">
      <button class="btn btn-primary" type="submit">Add user</button>
    </div>
  </form>
</main>
</body>
</html>
