<%- include('../partials/head', { title: 'Admin · Import Sites' }) %>
<%- include('../partials/admin-nav') %>
<main class="container" style="max-width:720px">
  <div class="page-header">
    <h1>Import sites</h1>
    <a class="btn btn-ghost" href="/admin/sites">Back to sites</a>
  </div>

  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

  <div class="card" style="margin-bottom:20px">
    <p>
      Upload or paste a <strong>sites-backup-*.json</strong> file exported from this app.
      Each site's URL is used as the unique key.
    </p>
    <ul class="muted small" style="margin:8px 0 0 18px;line-height:1.8">
      <li><strong>Skip existing</strong> — leaves already-monitored URLs untouched, only adds new ones.</li>
      <li><strong>Update existing</strong> — overwrites settings (name, thresholds, notifications) for matching URLs and adds new ones.</li>
    </ul>
  </div>

  <form method="post" action="/admin/sites/import" id="import-form">
    <div class="card" style="margin-bottom:16px">
      <label class="form-label" for="file-picker">Load from file</label>
      <input type="file" id="file-picker" accept=".json,application/json"
             style="display:block;margin-bottom:12px" />

      <label class="form-label" for="json-input">
        JSON — paste directly or use the file picker above
      </label>
      <textarea id="json-input" name="json" rows="14"
                class="form-control" style="font-family:monospace;font-size:12px"
                placeholder='{"exported_at":"…","sites":[…]}'
                required></textarea>
    </div>

    <div class="card" style="margin-bottom:20px">
      <label class="form-label">On duplicate URL</label>
      <div style="display:flex;gap:24px;margin-top:4px">
        <label style="cursor:pointer">
          <input type="radio" name="mode" value="skip" checked> Skip existing (safe default)
        </label>
        <label style="cursor:pointer">
          <input type="radio" name="mode" value="update"> Update existing settings
        </label>
      </div>
    </div>

    <div style="display:flex;gap:10px">
      <button class="btn btn-primary" type="submit"
              onclick="this.disabled=true;this.textContent='Importing…'">
        Import sites
      </button>
      <a class="btn btn-ghost" href="/admin/sites">Cancel</a>
    </div>
  </form>
</main>

<script>
document.getElementById('file-picker').addEventListener('change', function () {
  const file = this.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = function (e) {
    document.getElementById('json-input').value = e.target.result;
  };
  reader.readAsText(file);
});
</script>
</body>
</html>
