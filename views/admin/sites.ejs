<%- include('../partials/head', { title: 'Admin · Sites' }) %>
<%- include('../partials/admin-nav') %>
<main class="container">
  <div class="page-header">
    <h1>Sites</h1>
    <div style="display:flex; gap:8px; align-items:center;">
      <button type="button" class="btn btn-danger" id="delete-selected" disabled onclick="submitBulkDelete()">Delete selected</button>
      <form action="/admin/sites/check-all" method="post" style="display:inline"
            onsubmit="this.querySelector('button').disabled=true; this.querySelector('button').textContent='Checking…';">
        <button class="btn btn-ghost" type="submit">Check all now</button>
      </form>
      <a class="btn btn-ghost" href="/admin/sites/bulk">Bulk add</a>
      <a class="btn btn-primary" href="/admin/sites/new">+ Add site</a>
    </div>
  </div>
  <% if (flash) { %><div class="alert alert-info"><%= flash %></div><% } %>

  <form id="bulk-delete-form" action="/admin/sites/bulk-delete" method="post" style="display:none"></form>

  <table class="table" id="sites-table">
    <thead>
      <tr>
        <th style="width:28px"></th>
        <th style="width:36px"><input type="checkbox" id="select-all" title="Select all"></th>
        <th>Status</th>
        <th>Name</th>
        <th>URL</th>
        <th>Enabled</th>
        <th>Notify</th>
        <th>Expected status</th>
        <th>Keyword</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="sites-tbody">
      <% sites.forEach(s => { %>
        <tr data-site-id="<%= s.id %>">
          <td><span class="drag-handle" title="Drag to reorder">⠿</span></td>
          <td><input type="checkbox" class="row-cb" value="<%= s.id %>"></td>
          <td class="site-status-cell">
            <% if (s.last) { %>
              <span class="dot dot-<%= s.last.is_up ? 'ok' : 'down' %>" style="width:9px;height:9px;display:inline-block;vertical-align:middle;flex-shrink:0;"></span>
              <span style="vertical-align:middle"><%= s.last.is_up ? 'Up' : 'Down' %><% if (s.last.status_code) { %> <span class="muted small">· <%= s.last.status_code %></span><% } %></span>
              <% if (s.last.redirect_count > 0) { %>
                <span class="admin-redirect-tag" title="Redirects to <%= s.last.final_url || '?' %>">redirect ×<%= s.last.redirect_count %></span>
              <% } %>
            <% } else { %>
              <span class="muted small">No data</span>
            <% } %>
          </td>
          <td><strong><%= s.name %></strong></td>
          <td><a href="<%= s.url %>" target="_blank" rel="noopener"><%= s.url %></a></td>
          <td><%= s.enabled ? 'Yes' : 'No' %></td>
          <td><%= s.notify_on_down ? 'Yes' : 'No' %></td>
          <td><%= s.expected_status %></td>
          <td><%= s.expected_keyword || '—' %></td>
          <td class="actions">
            <form action="/admin/sites/<%= s.id %>/check" method="post" style="display:inline">
              <button class="btn btn-ghost" type="submit">Check now</button>
            </form>
            <a class="btn btn-ghost" href="/admin/sites/<%= s.id %>/edit">Edit</a>
            <form action="/admin/sites/<%= s.id %>/delete" method="post" style="display:inline"
                  onsubmit="return confirm('Delete <%= s.name %>?')">
              <button class="btn btn-danger" type="submit">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</main>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.6/Sortable.min.js"></script>
<script>
  // --- Drag-and-drop reorder ---
  const tbody = document.getElementById('sites-tbody');
  let saveTimer = null;

  Sortable.create(tbody, {
    handle: '.drag-handle',
    animation: 150,
    ghostClass: 'sortable-ghost',
    onEnd() {
      clearTimeout(saveTimer);
      saveTimer = setTimeout(() => {
        const ids = [...tbody.querySelectorAll('tr')].map(tr => Number(tr.dataset.siteId));
        fetch('/admin/sites/reorder', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ids }),
        }).catch(() => {});
      }, 400);
    },
  });

  // --- Bulk delete ---
  const selectAll = document.getElementById('select-all');
  const deleteBtn = document.getElementById('delete-selected');

  function updateDeleteBtn() {
    const n = document.querySelectorAll('.row-cb:checked').length;
    deleteBtn.disabled = n === 0;
    deleteBtn.textContent = n > 0 ? `Delete selected (${n})` : 'Delete selected';
  }

  selectAll.addEventListener('change', () => {
    document.querySelectorAll('.row-cb').forEach(cb => { cb.checked = selectAll.checked; });
    updateDeleteBtn();
  });

  document.querySelectorAll('.row-cb').forEach(cb => {
    cb.addEventListener('change', () => {
      const all = document.querySelectorAll('.row-cb');
      const checked = document.querySelectorAll('.row-cb:checked');
      if (checked.length === 0) selectAll.checked = false;
      else if (checked.length === all.length) { selectAll.checked = true; selectAll.indeterminate = false; }
      else { selectAll.checked = false; selectAll.indeterminate = true; }
      updateDeleteBtn();
    });
  });

  function submitBulkDelete() {
    const checked = [...document.querySelectorAll('.row-cb:checked')].map(cb => cb.value);
    if (checked.length === 0) return;
    if (!confirm(`Delete ${checked.length} site(s)? This cannot be undone.`)) return;
    const form = document.getElementById('bulk-delete-form');
    form.innerHTML = checked.map(id => `<input type="hidden" name="ids" value="${id}">`).join('');
    form.submit();
  }
</script>
</body>
</html>
